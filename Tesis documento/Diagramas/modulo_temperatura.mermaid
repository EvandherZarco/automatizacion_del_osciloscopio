flowchart TD

    %% ─────────────────────────────
    %% SUB-FLUJO 1: CONEXIÓN INICIAL
    %% ─────────────────────────────
    INIT([🌡️ Temperatura: Conexión inicial])
    INIT --> CONNECT["Abre puerto serial (TEMP_COM_PORT)\nESP32 WROOM-32 · USB · 115200 baud\nDTR y RTS en bajo · envía START"]
    CONNECT --> CONNOK{¿Puerto abierto?}
    CONNOK --> |No| CONNERR[/"⚠️ No se pudo abrir el puerto\nVerifique cable USB y puerto en Conexión"/]
    CONNERR --> CONNFAIL([Emite desconectado\na Conexión y monitoreo])

    CONNOK --> |Sí| WAITFIRST["Espera primera trama válida\n(máx. 5 s)"]
    WAITFIRST --> FIRSTOK{¿Llega trama\nválida?}
    FIRSTOK --> |No — 5 s| CONNERR
    FIRSTOK --> |Sí| PARSECHECK["Parsea: promedio, S1, S2, S3, S4 en °C\nformato: '21.47,21.44,21.69,21.25,21.50'"]
    PARSECHECK --> SENSORCHECK{¿S1–S4 dentro\nde 10–50 °C?}
    SENSORCHECK --> |Sí| READY
    SENSORCHECK --> |No| SENSORWARN[/"⚠️ Sensores no detectados: [lista]\n(NaN o 85 °C cuentan como ausentes)\nMediciones afectadas → error_flag=1"/]
    SENSORWARN --> READY

    READY(["✅ Emite conectado\nInicia loop de lectura"])
    READY --> LOOP

    %% ─────────────────────────────
    %% SUB-FLUJO 2: LOOP DE LECTURA
    %% (QThread separado)
    %% ─────────────────────────────
    LOOP["🔄 Loop continuo\nen QThread"]
    LOOP --> READLINE["Lee línea serial\n(timeout 1.5 s; ESP32 envía ~1/s)"]
    READLINE --> PARSE{"¿Trama válida?\n5 campos numéricos y\npromedio en 10–50 °C"}

    PARSE --> |No — vacía, mal formada\no promedio fuera de rango| TOCHECK{¿> 5 s sin\ntrama válida?}
    TOCHECK --> |No| READLINE
    TOCHECK --> |Sí| DISCON[/"⚠️ ESP32 sin tramas válidas por 5 s\nEmite desconectado · cierra puerto\n(sin conservar dato como vigente)"/]
    DISCON --> RECON([Reconexión a cargo de\nConexión y monitoreo])

    PARSE --> |Sí| UPDATE["Actualiza en memoria:
    ─────────────────────────────
    ultima_temp ← promedio
    lecturas S1–S4 (None si ausente)
    repetidos S1–S4 (valor idéntico al anterior)
    timestamp_lectura ← ahora"]
    UPDATE --> EMIT["Emite trigger(promedio)"]
    EMIT --> READLINE

    %% ─────────────────────────────
    %% SUB-FLUJO 3: CONSULTA
    %% (Trigger, Medición, GUI)
    %% ─────────────────────────────
    QUERY([🌡️ Temperatura: Consulta])
    QUERY --> GET["consultar() / consultar_sensores()\n(thread-safe)"]
    GET --> FRESHCHECK{¿Última lectura\n< 3 s de antigüedad?}
    FRESHCHECK --> |Sí| RETURN[/"Devuelve valores\ncon es_fresco = True"/]
    FRESHCHECK --> |No| STALE[/"Devuelve valores\ncon es_fresco = False\n→ quien consulta no los usa como vigentes"/]
    RETURN --> CALLER([Regresa al módulo\nque consultó])
    STALE --> CALLER
